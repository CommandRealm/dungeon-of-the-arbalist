##Called to give us armor.

##clear
clear @s minecraft:iron_boots[minecraft:custom_data={armor_piece:1b}]
clear @s minecraft:iron_chestplate[minecraft:custom_data={armor_piece:1b}]

clear @s minecraft:golden_boots[minecraft:custom_data={armor_piece:1b}]
