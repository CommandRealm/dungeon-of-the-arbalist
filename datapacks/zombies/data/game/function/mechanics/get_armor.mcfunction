clear @s minecraft:leather_leggings[minecraft:custom_data={armor_piece:1b}]

clear @s minecraft:elytra[minecraft:custom_data={armor_piece:1b}]

##killing nearby Items
kill @e[type=minecraft:item,distance=..5,nbt={Item:{components:{"minecraft:custom_data":{armor_piece:1b}}}}]

##Leggings

execute unless score @s color matches 16777215 run function game:mechanics/get_colored_leggings

execute if score @s color matches 16777215 run item replace entity @s armor.legs with minecraft:leather_leggings[minecraft:attribute_modifiers={modifiers:[{type:"minecraft:generic.armor",id:"minecraft:0000012c-0000-012c-0000-012c0000012c",amount:0.0d},{type:"minecraft:generic.knockback_resistance",id:"minecraft:0000012d-0000-012d-0000-012d0000012d",amount:0.0d}]},minecraft:custom_name='{"color":"yellow","italic":false,"text":"Leggings"}',minecraft:unbreakable={show_in_tooltip:0b},minecraft:hide_additional_tooltip={},minecraft:custom_data={armor_piece:1b}]

